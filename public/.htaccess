# ====================================================================
# RYDENTEC — CONFIGURAÇÃO APACHE / HOSTGATOR (.htaccess)
# ====================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Roteamento de API se hospedado em Apache com PHP
  RewriteRule ^api/settings/?$ api/settings.php [L,QSA]
  RewriteRule ^api/portfolio/?$ api/portfolio.php [L,QSA]
  RewriteRule ^api/leads/?$ api/leads.php [L,QSA]
  RewriteRule ^api/analytics/track/?$ api/track.php [L,QSA]

  # 2. Manter arquivos e pastas existentes intactos (assets, brand, css, js)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Redirecionar todas as rotas SPA para o index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Compressão GZIP para carregamento ultra-rápido
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Cache de arquivos estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 month"
</IfModule>

# Bloquear listagem de diretórios por segurança
Options -Indexes

# Cabeçalhos de Segurança
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
