# ====================================================================
# RYDENTEC — ROTEAMENTO RAIZ PARA DEPLOY DIRETO VIA GIT NO CPANEL
# ====================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Preservar header Authorization (necessário para login /admin no PHP)
  RewriteCond %{HTTP:Authorization} ^(.*)
  RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

  # 1. Bloquear acesso público a pastas sensíveis e código-fonte
  RewriteRule ^(data|dist/data|server|src|node_modules|\.git|package\.json|package-lock\.json|vite\.config\.js|tailwind\.config\.js) - [F,L]

  # 2. Rotear API para o backend PHP dentro de dist/api/
  RewriteRule ^api/(.*)$ dist/api/index.php?route=$1 [L,QSA]

  # 3. Servir página inicial e arquivos estáticos compilados a partir de dist/
  RewriteRule ^$ dist/index.html [L]
  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]
  RewriteRule ^brand/(.*)$ dist/brand/$1 [L]
  RewriteRule ^(robots\.txt|sitemap\.xml)$ dist/$1 [L]

  # 4. Deixar requisições já direcionadas para dist/ seguirem normalmente
  RewriteRule ^dist/ - [L]

  # 5. Fallback SPA (/admin, /preview, etc.) para dist/index.html
  RewriteRule ^ dist/index.html [L]
</IfModule>

# Compressão GZIP para carregamento ultra-rápido
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Cache de arquivos estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 month"
</IfModule>

Options -Indexes

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
